{
  "name": "log-proxy-microservices",
  "version": "1.0.0",
  "description": "Microservices architecture that centralizes logs through a Proxy pattern",
  "private": true,
  "type": "module",
  "workspaces": [
    "services/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start-all.js",
    "start:log": "npm start -w log-service",
    "start:proxy": "npm start -w proxy-service",
    "start:simulator": "npm start -w producer-simulator",
    "test": "npm test -w proxy-service -w log-service"
  }
}
